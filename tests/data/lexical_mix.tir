$ synthetic, authored for magic-formula from docs/research/tir-format.md; not derived from any vendor file
$ purpose: same key/value set as pac2002_S.tir written with every lexical variant of the .tir syntax
$  (long comment line, over 300 characters)

[mdi_header]
FILE_TYPE = 'tir'
FILE_VERSION = 3.0
FILE_FORMAT = 'ASCII'
TIRE_DESCRIPTION = 'synthetic $ not a comment ! not a comment'
   
$ full-line comment between sections
[UNITS]
LENGTH = 'meter'
FORCE = 'newton'
ANGLE = 'radians'
MASS = 'kg'
TIME = 'second'
[INERTIA]
MASS = 9.3
[MODEL]
PROPERTY_FILE_FORMAT = 'Pac2002'
USE_MODE = 4.0
VXLOW = 1
LONGVL = 16.6 $Measurement speed
TYRESIDE = LEFT
[DIMENSION]
UNLOADED_RADIUS	=	0.3
[Vertical]
fnomin = 4.0e+003
[SHAPE]
{radial width}
 1.0 0.0
 1.0 0.4 $ trailing comment
 0.9 0.9
