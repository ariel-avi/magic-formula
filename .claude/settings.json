{
  "agent": "orchestrator",
  "permissions": {
    "allow": [
      "Bash(cmake *)",
      "Bash(ctest *)",
      "Bash(conan *)",
      "Bash(gcovr *)",
      "Bash(clang-format *)",
      "Bash(clang-tidy *)",
      "Workflow(feature)",
      "Workflow(review)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-master.sh"
          }
        ]
      }
    ]
  }
}
