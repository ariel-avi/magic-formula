{
  "name": "magic-formula-web",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:smoke": "vitest run --project smoke",
    "test:coverage": "vitest run --project unit --coverage",
    "wasm:setup": "bash ../wasm/setup-emsdk.sh",
    "wasm:build": "bash ../wasm/build.sh",
    "predev": "node scripts/check-wasm.mjs",
    "prebuild": "node scripts/check-wasm.mjs",
    "pretest": "node scripts/check-wasm.mjs",
    "pretest:smoke": "node scripts/check-wasm.mjs",
    "test:e2e": "playwright test",
    "pretest:e2e": "node scripts/check-wasm.mjs",
    "docs:screenshots": "MF_SCREENSHOT_DIR=../docs/images/web playwright test screenshots.spec.ts",
    "predocs:screenshots": "node scripts/check-wasm.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/stix-two-text": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.545.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "4.1.12",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
