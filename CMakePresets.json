{
  "version": 6,
  "cmakeMinimumRequired": { "major": 4, "minor": 0, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/build/conan/debug/conan_toolchain.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/build/conan/release/conan_toolchain.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "MF_BUILD_BENCH": "ON" }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (Debug + gcov)",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/build/conan/debug/conan_toolchain.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "MF_ENABLE_COVERAGE": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "coverage", "configurePreset": "coverage" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "coverage", "inherits": "base", "configurePreset": "coverage" }
  ]
}
